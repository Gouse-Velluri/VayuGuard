FROM python:3.11-slim

LABEL maintainer="VayuGuard Team"
LABEL description="VayuGuard Data Pipeline - AQI & Weather ingestion, cleaning, analytics"

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    cron \
    curl \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy pipeline code
COPY . .

# Create log directory
RUN mkdir -p /app/logs

# Copy crontab for scheduled runs
COPY cron-pipeline /etc/cron.d/pipeline-cron
RUN chmod 0644 /etc/cron.d/pipeline-cron
RUN crontab /etc/cron.d/pipeline-cron

# Health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import requests; requests.get('https://api.openaq.org/v2/cities', params={'limit': 1}, timeout=5)" || exit 1

# Default entrypoint runs the orchestrator
ENTRYPOINT ["python", "-m", "ingestion.orchestrator"]
