# =============================================================================
# VayuGuard MERN Frontend - Multi-stage Node Build → Nginx
# =============================================================================
# Builds the React/Next.js frontend and serves via nginx with SPA fallback
# =============================================================================

# ---------- Stage 1: Dependencies ----------
FROM node:20-alpine AS deps

WORKDIR /app

# Install build tools for native dependencies
RUN apk add --no-cache python3 make g++

# Copy package manifests
COPY frontend/package.json frontend/package-lock.json ./

# Install all dependencies (including devDependencies for build)
RUN npm ci && npm cache clean --force

# ---------- Stage 2: Build ----------
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy frontend source code
COPY frontend/ .

# Build-time environment variables
ENV NODE_ENV=production \
    NEXT_PUBLIC_API_URL=/api/v1 \
    NEXT_PUBLIC_ML_API_URL=/api/ml \
    NEXT_PUBLIC_WS_URL=/ws \
    NEXT_TELEMETRY_DISABLED=1

# Build the Next.js application
RUN npm run build

# ---------- Stage 3: Production Nginx ----------
FROM nginx:1.25-alpine AS runtime

# Metadata labels
LABEL maintainer="VayuGuard DevOps <devops@vayuguard.com>"
LABEL service="mern-frontend"
LABEL version="1.0.0"
LABEL description="VayuGuard frontend served via nginx"

# Install utilities and security patches
RUN apk add --no-cache \
    curl \
    tini \
    && addgroup -g 1001 -S nginx-custom \
    && rm -f /etc/nginx/conf.d/default.conf

# Copy custom nginx configuration
COPY infrastructure/nginx/reverse-proxy.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder
COPY --from=builder /app/out /usr/share/nginx/html
COPY --from=builder /app/.next/static /usr/share/nginx/html/_next/static

# Copy public assets
COPY --from=builder /app/public /usr/share/nginx/html

# Set proper permissions
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

# Environment variables for runtime configuration
ENV NGINX_WORKER_PROCESSES=auto \
    NGINX_WORKER_CONNECTIONS=1024

# Expose HTTP port
EXPOSE 3000

# Health check for nginx
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

# Use tini for proper signal handling
ENTRYPOINT ["tini", "--"]

# Start nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
